
[
    {{- range $i, $p := first 2 ((where site.RegularPages "Section" "ne" "farmate").ByDate.Reverse) -}}
    {{- if $i }},{{ end }}
    {
      
      "title": {{ with $p.Params.seo_title }}
        {{ . | jsonify }}
      {{ else }}
        {{ $p.Title | jsonify }}
      {{ end }},

      "content": {{ with $p.Params.Hindi_Sharing }}
        {{ index . 0 | jsonify }}
      {{ else }}
        {{ with $p.Params.Description }}
          {{ . | jsonify }}
        {{ else }}
          {{ $p.Summary | plainify | jsonify }}
        {{ end }}
      {{ end }},

      "type": "image",

      "sender": "YOJNA PORTAL POSTER",

      "sender_id": "yojna-portal",

      "sender_logo": "https://poster.yojnaportal.com/favicon.ico",

      "sender_website": "https://poster.yojnaportal.com",

      "image_url": {{ with $p.Params.imagePoster }}
        {{ . | jsonify }}
      {{ else }}
        {{ with $p.Params.imageBanner }}
          {{ . | jsonify }}
        {{ else }}
          ""
        {{ end }}
      {{ end }},

      "image_download_allowed": true,

      "link_url": {{ printf "%s%s" site.BaseURL $p.RelPermalink | jsonify }},

   
    }
    {{- end }}
  ]
